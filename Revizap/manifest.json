{
   "action": {
      "default_icon": "assets/icon.png"
   },
   "background": {
      "service_worker": "/background.js"
   },
   "content_scripts": [ {
      "js": [ "/index.js" ],
      "matches": [ "https://web.whatsapp.com/*" ]
   }, {
      "js": [ "/whatsapp-functions.js" ],
      "matches": [ "https://web.whatsapp.com/*" ],
      "world": "MAIN"
   } ],
   "description": "Revzap - Automação para o seu Whatsapp!",
   "host_permissions": [ "https://web.whatsapp.com/*", "https://api.revzap.com.br/*", "https://clients2.google.com/service/update2/crx/*" ],
   "icons": {
      "128": "assets/icon.png",
      "16": "assets/icon.png",
      "48": "assets/icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Revzap",
   "permissions": [ "unlimitedStorage", "alarms", "tabs", "storage" ],
   "version": "2.0.9.3",
   "web_accessible_resources": [ {
      "matches": [ "https://web.whatsapp.com/*" ],
      "resources": [ "/assets/*", "/whatsapp-functions.js", "/mensagens.json" ]
   } ]
}
