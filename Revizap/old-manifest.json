{
  "manifest_version": 3,
  "name": "Revzap",
  "version": "2.0.4.0",
  "description": "Revzap - Automação para o seu Whatsapp!",
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.revzap.com.br/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["/assets/*", "/whatsapp.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "content_scripts": [
    {
      "js": ["/index.js"],
      "matches": ["https://web.whatsapp.com/*"]
    },
    {
      "js": ["/whatsapp-functions.js", "/listener.js"],
      "matches": ["https://web.whatsapp.com/*"],
      "world": "MAIN"
    }
  ],
  "action": {
    "default_icon": "assets/icon.png"
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "permissions": ["unlimitedStorage", "alarms", "tabs", "storage"],
  "background": {
    "service_worker": "/background.js"
  }
}